#!/usr/bin/env bash
# setup-proxy.sh — generate the dual-layer egress allow-list (arch-09 §4).
#
# Combines a GLOBAL allow-list (shipped with the standards) and a LOCAL project
# allow-list into one de-duplicated artifact that an ENFORCING egress proxy
# consumes, and records the proxy pointer (EGRESS_PROXY) plus a loopback-only
# NO_PROXY bypass in .env for docker compose.
#
# WHAT THIS SCRIPT DOES NOT DO: it does not block any traffic. Writing a proxy
# URL into HTTP(S)_PROXY only tells cooperative tools where to send requests;
# a process that ignores or unsets the variable still reaches the internet
# directly. Deny-by-default egress exists only once an enforcing proxy or
# firewall consumes the generated allow-list and the container network is
# `internal: true` (see docker-compose.dev.yml). That sidecar is tracked in
# c65llc/coding-standards#157. Always verify the deny path with a real request.
#
# The generated output is an artifact — edit the source lists, never the output.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

# Global layer ships with the standards submodule; local layer is project-owned.
GLOBAL_LIST="${GLOBAL_WHITELIST:-coding_standards/templates/containerized-dev/network/global-whitelist.txt}"
LOCAL_LIST="${LOCAL_WHITELIST:-proxy/project-whitelist.txt}"
# The combined allow-list the enforcing proxy reads. Git-ignore it or commit it;
# either way, regenerate rather than edit.
OUTPUT_LIST="${ALLOWLIST_OUTPUT:-proxy/allowlist.generated.txt}"
ENV_FILE="$ROOT_DIR/.env"
# Address the container reaches the egress proxy on. Default assumes a sidecar
# proxy service named "egress" on port 3128.
EGRESS_PROXY="${EGRESS_PROXY:-http://egress:3128}"
# NO_PROXY is a proxy *bypass* list: destinations tools talk to directly instead
# of via the proxy. It is NOT an allow-list. Keep it to loopback and in-compose
# service names so nothing on the public internet bypasses the proxy.
NO_PROXY_VALUE="${NO_PROXY_BYPASS:-localhost,127.0.0.1,::1}"

warn() { printf '\033[1;33m%s\033[0m\n' "$1" >&2; }
green() { printf '\033[0;32m%s\033[0m\n' "$1"; }

# Read a whitelist file, dropping comments and blank lines (arch-09 §4).
read_list() {
    local file="$1"
    [ -f "$file" ] || { warn "Whitelist not found: $file (skipping)"; return 0; }
    # Strip comments/blanks/whitespace.
    sed -e 's/#.*//' -e 's/[[:space:]]//g' "$file" | grep -v '^$' || true
}

combined="$(
    { read_list "$GLOBAL_LIST"; read_list "$LOCAL_LIST"; } | sort -u
)"

if [ -z "$combined" ]; then
    warn "Combined allow-list is EMPTY. Refusing to generate an open egress config."
    warn "Populate $GLOBAL_LIST and/or $LOCAL_LIST first."
    exit 1
fi

# --- 1. Allow-list artifact for the enforcing proxy ---------------------------
mkdir -p "$(dirname "$OUTPUT_LIST")"
{
    echo "# GENERATED by scripts/setup-proxy.sh — do not edit. Sources:"
    echo "#   $GLOBAL_LIST"
    echo "#   $LOCAL_LIST"
    echo "$combined"
} > "$OUTPUT_LIST"

# --- 2. Managed keys in .env (idempotent, preserves every other line) ---------
touch "$ENV_FILE"
tmp="$(mktemp)"
grep -v -E '^(NO_PROXY|EGRESS_PROXY)=' "$ENV_FILE" > "$tmp" || true
{
    echo "EGRESS_PROXY=${EGRESS_PROXY}"
    echo "NO_PROXY=${NO_PROXY_VALUE}"
} >> "$tmp"
mv "$tmp" "$ENV_FILE"

count="$(echo "$combined" | wc -l | tr -d ' ')"
green "Allow-list: ${count} host(s) written to ${OUTPUT_LIST}."
echo "Wrote EGRESS_PROXY=${EGRESS_PROXY} and NO_PROXY=${NO_PROXY_VALUE} to .env."
echo
warn "This script does not enforce anything by itself."
warn "Point an enforcing egress proxy (or firewall) at ${OUTPUT_LIST}, make the"
warn "container network internal, then verify the deny path (arch-09 §4):"
echo "  docker compose -f docker-compose.dev.yml exec dev curl -sS --max-time 5 https://malicious-site.com"
echo "  (MUST fail; if it succeeds, egress is NOT contained — see #157)"
