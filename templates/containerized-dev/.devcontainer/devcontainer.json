{
  // VS Code Dev Containers config (arch-09 §7). "Reopen in Container" attaches
  // VS Code to the same dev service (and the same /workspace) the CLI agents use.
  "name": "agent-dev",
  "dockerComposeFile": ["../docker-compose.dev.yml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "remoteUser": "developer",
  // Run identity + secret injection, then generate the egress allow-list, before
  // compose starts: the egress sidecar refuses to start without the allow-list,
  // and the dev service waits for the sidecar to be healthy (arch-09 §4).
  // This runs ON THE HOST. It is safe only because docker-compose.dev.yml mounts
  // scripts/ (and this directory) read-only into the dev container, so nothing
  // the agent can write is ever executed here. Keep both facts in step.
  "initializeCommand": "./scripts/init-workspace.sh && ./scripts/setup-proxy.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "Google.gemini-cli-vscode-ide-companion",
        "ms-vscode-remote.remote-containers"
      ]
    }
  }
}
