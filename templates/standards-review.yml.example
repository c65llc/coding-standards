# .github/workflows/standards-review.yml
# Standards compliance review on pull requests.
# Copied here by setup.sh — update path if .standards/ is at a different location.
#
# Note: For PRs from forks, GITHUB_TOKEN is read-only and the comment step
# will be skipped. If you add a pull_request_target job for fork support,
# keep it metadata-only: that event checks out the BASE branch by default, so
# content checks there would inspect trusted base code rather than the PR,
# and checking out the PR head in that privileged context runs untrusted
# code. Run the PR-title check (pr-title-check) in the pull_request_target
# job and keep this pull_request job for content linting.
# https://docs.github.com/en/actions/reference/security/securely-using-pull_request_target
#
# ci-hygiene: paths-exempt — compliance review (commit history, secrets, CI
# hygiene) applies to every PR regardless of which paths changed.
name: Standards Review

on:
  pull_request:

permissions:
  contents: read
  pull-requests: write

# A newer push supersedes the previous review run (arch-08 §3).
concurrency:
  group: standards-review-${{ github.ref }}
  cancel-in-progress: true

jobs:
  standards-review:
    name: Standards Review
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Full history for commit checks

      - name: Run standards review
        uses: ./.standards/.github/actions/standards-review
