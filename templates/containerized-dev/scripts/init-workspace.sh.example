#!/usr/bin/env bash
# init-workspace.sh — developer entry point for the containerized agent env.
#
# Idempotent. Re-running refreshes identity/secrets without clobbering local
# edits: only the keys this script manages are rewritten in .env (HOST_UID,
# HOST_GID, SSH_AUTH_SOCK); every other line — including the EGRESS_PROXY/NO_PROXY
# keys written by setup-proxy.sh and anything you added by hand — is preserved.
# See arch-09 §5 (identity injection).
#
# What it does:
#   1. Forwards the host SSH agent + git identity into the compose environment.
#   2. Detects provider API keys on the host and writes a git-ignored .env.secret.
#
# THIS SCRIPT RUNS ON THE HOST (devcontainer.json initializeCommand, or by hand)
# against a workspace the agent container can write to. It therefore never runs
# `git` — or any other tool that reads container-writable configuration — because
# .git/config (core.hooksPath, core.fsmonitor, aliases, includes) and .gitmodules
# would let an agent run code on the host at the next invocation. Submodules are
# synced by you, on the host, after reviewing the diff:
#   git submodule update --init --recursive
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

SECRET_FILE="$ROOT_DIR/.env.secret"
ENV_FILE="$ROOT_DIR/.env"
MANAGED_ENV_KEYS='HOST_UID|HOST_GID|SSH_AUTH_SOCK'

green() { printf '\033[0;32m%s\033[0m\n' "$1"; }
warn()  { printf '\033[1;33m%s\033[0m\n' "$1" >&2; }

# Replace only the managed keys in .env, keeping every other line intact.
# Usage: upsert_env KEY=VALUE [KEY=VALUE ...]
upsert_env() {
    local tmp
    touch "$ENV_FILE"
    tmp="$(mktemp)"
    grep -v -E "^(${MANAGED_ENV_KEYS})=" "$ENV_FILE" > "$tmp" || true
    printf '%s\n' "$@" >> "$tmp"
    mv "$tmp" "$ENV_FILE"
}

# --- 0. Guard: .env.secret must be git-ignored before we ever write it --------
# Checked by reading .gitignore directly, not via `git check-ignore`: git would
# consult the container-writable .git/config (see the header). Accepts the exact
# patterns the kit README installs, plus the obvious equivalents.
is_secret_ignored() {
    [ -f "$ROOT_DIR/.gitignore" ] || return 1
    sed -e 's/[[:space:]]*$//' "$ROOT_DIR/.gitignore" \
        | grep -q -x -E '/?\.env\.secret|/?\*\.secret|/?\.env\*|/?\.env\.\*'
}
if ! is_secret_ignored; then
    warn "Refusing to write .env.secret: .gitignore does not list it."
    warn "Add a '.env.secret' line to .gitignore first (arch-09 §5, P0)."
    exit 1
fi

# --- 1. Identity: SSH agent + git config (arch-09 §5) -------------------------
identity=("HOST_UID=$(id -u)" "HOST_GID=$(id -g)")
if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK}" ]; then
    identity+=("SSH_AUTH_SOCK=${SSH_AUTH_SOCK}")
else
    warn "No SSH agent socket found (SSH_AUTH_SOCK). Git push from the container may fail."
    warn "Start one with: eval \"\$(ssh-agent -s)\" && ssh-add"
fi
upsert_env "${identity[@]}"
green "Updated host identity keys in .env (other entries preserved)."

# --- 2. Secrets: detect provider keys, write git-ignored .env.secret ----------
# Only write keys that are actually present; never emit an empty value.
: > "$SECRET_FILE"
chmod 600 "$SECRET_FILE"
echo "# Generated by init-workspace.sh — DO NOT COMMIT. Injected at runtime." >> "$SECRET_FILE"

wrote_any=false
for var in ANTHROPIC_API_KEY GOOGLE_API_KEY GEMINI_API_KEY GH_TOKEN; do
    value="${!var:-}"
    if [ -n "$value" ]; then
        echo "${var}=${value}" >> "$SECRET_FILE"
        green "  + captured ${var}"
        wrote_any=true
    fi
done
[ "$wrote_any" = true ] || warn "No provider API keys found in the host environment."

# --- 3. Submodules are NOT touched here (see the header) ----------------------
# The standards live at .standards/ (setup.sh --containerized) or coding_standards/
# (hand-vendored); setup-proxy.sh looks in the same two places.
if [ -f "$ROOT_DIR/.gitmodules" ] && [ ! -e "$ROOT_DIR/.standards/templates" ] \
   && [ ! -e "$ROOT_DIR/coding_standards/templates" ]; then
    warn "Standards submodule looks uninitialised. On the host, after reviewing .gitmodules:"
    warn "  git submodule update --init --recursive"
fi

green "Workspace ready. Next: ./scripts/setup-proxy.sh && docker compose -f docker-compose.dev.yml up -d --build"
