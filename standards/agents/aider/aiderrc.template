# Aider configuration. Canonical source: standards/agents/aider/aiderrc.template.
# Generated/synced by sync-standards.sh; `make doctor` reports drift.
# See .aider-instructions.md for coding standards and behavioral rules.
# The template pins no model: Aider reads it from its own config or --model.
# A `model =` line a project adds below is kept by every sync, so a standards
# sync never changes which model a project runs (#184).

read = .aider-instructions.md
auto-lint = true
show-diffs = true

# Files to exclude from Aider context
file-ignore = [
    "*.pyc",
    "__pycache__",
    ".git",
    "node_modules",
    ".standards_tmp",
    "coverage",
    "dist",
    "build",
    ".pytest_cache",
    ".ruff_cache",
    ".mypy_cache",
    ".venv",
    "venv",
]
