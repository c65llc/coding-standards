# .gitleaks.toml — shape-based allowlist for Gitleaks. Copy to .gitleaks.toml.
#
# sec-01 §3 "Scanner False Positives on Test Fixtures". Test fixtures trip
# secret scanners for predictable reasons: UUIDv7 ids look like tokens, a
# redaction test needs a plausible password to redact, a fake credential in a
# `*_test` file is the whole point of the test. The usual response — a second
# and third allowlist round, each excluding one more PATH — ends with whole
# trees unscanned. Allowlist the SHAPE of the false positive instead: a regex
# that matches the fixture's form and nothing a real secret would take. Path
# excludes are the last resort, and every entry here states why it exists.
#
# Two mechanisms, finest granularity first:
#   1. Inline, on the exact line:   `… // gitleaks:allow`  (Gitleaks)
#                                   `… // trufflehog:ignore` (TruffleHog)
#      Put BOTH markers on a line that trips both scanners. The marker
#      documents the false positive where a reader meets it and keeps the rest
#      of the file scanned. Prefer this for one-off constants.
#   2. This file, for a shape that recurs across many fixtures. Each regex
#      below is anchored to the shape and names the fixture family it covers.
#
# The single `[allowlist]` form below works on every 8.x release. The
# `[[allowlists]]` block at the END of the file (Gitleaks ≥ 8.21) ANDs a path
# condition with a shape, which is how a shape that a real secret can also
# take (a UUID) is confined to fixture locations instead of being allowlisted
# globally. Keep it last: TOML assigns every key after an array-of-tables
# header to that element.

title = "project gitleaks config"

[extend]
# Start from the built-in rule set; this file only adds allowlist entries.
useDefault = true

[allowlist]
description = "Shape-based allowlist for test fixtures (sec-01 §3)"
# No `regexTarget`: Gitleaks then tests these regexes against the extracted
# SECRET (the rule's capture group). That is what the anchored shapes below
# expect — `password = "test-foo"` is suppressed because the secret
# `test-foo` matches, and a real secret that shares a line with a fixture is
# still reported. `regexTarget = "match"` would test the rule's whole match
# (key name and `=` included) and `"line"` the entire line; neither fits an
# anchored shape. Regexes are Go RE2: no backreferences, no lookaround.

regexes = [
  # (UUID-shaped values are NOT allowlisted here: many services issue API
  # keys that are UUIDs, so a global UUID shape would silently drop a real
  # finding. UUID fixtures are handled by the scoped block further down.)
  # Fake passwords by naming convention: a value that announces itself
  # (test-, fake-, dummy-, example-, not-a-real-, changeme) is a fixture, not
  # a credential. Keep the convention and the scanner stays quiet.
  '''^(test|fake|dummy|example|placeholder|not-a-real|changeme|hunter2)[-_a-zA-Z0-9]*$''',
  # Redaction-test output: the scanner sees the redacted form, which is only
  # asterisks or the literal REDACTED marker, never a secret.
  '''^(\*{4,}|\[?REDACTED\]?|<redacted>)$''',
  # Repeated-character fixtures (`xxxxxxxx…`, `0000…`, `aaaa…`) used to pad a
  # token to the right length in a parser test. RE2 has no backreference, so
  # the usual padding characters are enumerated; add yours to the alternation.
  '''(?i)^(0{16,}|1{16,}|9{16,}|a{16,}|f{16,}|x{16,}|z{16,})$''',
]

# Stopwords are matched against the secret itself (case-insensitive). A token
# that contains one of these is a fixture by construction.
stopwords = [
  "example",
  "fixture",
  "placeholder",
  "not-a-real",
  "redacted",
]

# Path excludes — the LAST resort. Each one covers a path that is all-noise by
# construction (lockfile hashes, generated bundles). Never exclude `tests/` or
# `fixtures/` wholesale: the regexes above cover the fixture shapes, and a
# real secret pasted into a test file must still be caught.
paths = [
  '''(^|/)pnpm-lock\.yaml$''',
  '''(^|/)package-lock\.json$''',
  '''(^|/)yarn\.lock$''',
  '''(^|/)Cargo\.lock$''',
  '''(^|/)poetry\.lock$''',
  '''(^|/)Package\.resolved$''',
  '''\.min\.(js|css)$''',
  '''(^|/)dist/''',
]

# ---------------------------------------------------------------------------
# Everything above belongs to the global [allowlist] table. Array-of-table
# blocks come LAST: in TOML every key after a `[[allowlists]]` header belongs
# to that element, so a global key placed below it would be mis-assigned (and
# a duplicate `paths` would make the file unparseable).
# ---------------------------------------------------------------------------

# UUID fixtures (Gitleaks ≥ 8.21). A UUID is a shape a real API key can take,
# so the shape alone does not make a value safe. This block suppresses a
# UUID-shaped secret ONLY when it sits in a test or fixture path — both
# conditions must hold (`condition = "AND"`). It is not a path exclude: a
# non-UUID secret in a test file is still reported. On Gitleaks < 8.21 the
# table is ignored; mark UUID fixture lines inline (`// gitleaks:allow`).
[[allowlists]]
description = "UUID-shaped ids in test fixtures only (sec-01 §3)"
condition = "AND"
paths = [
  '''(^|/)(tests?|__tests__|spec|fixtures)/''',
  '''(_test|\.test|\.spec|_spec)\.[A-Za-z0-9]+$''',
]
regexes = [
  # UUIDv7 (version nibble 7, variant 8-b): time-ordered fixture primary keys.
  '''^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$''',
  # Any RFC 4122 UUID (v1–v5) for fixtures that are not time-ordered.
  '''^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$''',
]
