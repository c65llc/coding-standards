#!/usr/bin/env bash
# setup-proxy.sh — generate the dual-layer egress allow-list (arch-09 §4).
#
# Combines a GLOBAL allow-list (shipped with the standards) and a LOCAL project
# allow-list into one de-duplicated set, then emits the runtime enforcement
# values (NO_PROXY + a proxy pointer) into .env for docker compose.
#
# The generated output is an artifact — edit the source lists, never the output.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

# Global layer ships with the standards submodule; local layer is project-owned.
GLOBAL_LIST="${GLOBAL_WHITELIST:-coding_standards/network/global-whitelist.txt}"
LOCAL_LIST="${LOCAL_WHITELIST:-proxy/project-whitelist.txt}"
ENV_FILE="$ROOT_DIR/.env"
# Address the container reaches the egress proxy on. Default assumes a sidecar
# proxy service named "egress" on port 3128.
EGRESS_PROXY="${EGRESS_PROXY:-http://egress:3128}"

warn() { printf '\033[1;33m%s\033[0m\n' "$1" >&2; }

# Read a whitelist file, dropping comments and blank lines (arch-09 §4).
read_list() {
    local file="$1"
    [ -f "$file" ] || { warn "Whitelist not found: $file (skipping)"; return 0; }
    # Strip comments/blanks/whitespace.
    sed -e 's/#.*//' -e 's/[[:space:]]//g' "$file" | grep -v '^$' || true
}

combined="$(
    { read_list "$GLOBAL_LIST"; read_list "$LOCAL_LIST"; } | sort -u
)"

if [ -z "$combined" ]; then
    warn "Combined allow-list is EMPTY. Refusing to generate an open egress config."
    warn "Populate $GLOBAL_LIST and/or $LOCAL_LIST first."
    exit 1
fi

# NO_PROXY is a comma-separated set of hosts that bypass the proxy — i.e. the
# ALLOWED destinations. Everything else must route through the deny-by-default
# proxy, which only forwards to the same allow-list.
no_proxy_value="$(echo "$combined" | paste -sd, -)"

# Rewrite the managed block in .env (idempotent).
touch "$ENV_FILE"
tmp="$(mktemp)"
grep -v -E '^(NO_PROXY|EGRESS_PROXY)=' "$ENV_FILE" > "$tmp" || true
{
    echo "EGRESS_PROXY=${EGRESS_PROXY}"
    echo "NO_PROXY=${no_proxy_value}"
} >> "$tmp"
mv "$tmp" "$ENV_FILE"

printf '\033[0;32mEgress allow-list: %d host(s) permitted; all others denied.\033[0m\n' \
    "$(echo "$combined" | wc -l | tr -d ' ')"
echo "Wrote EGRESS_PROXY and NO_PROXY to .env."
echo
echo "Verify the deny path (arch-09 §4) — this MUST fail:"
echo "  docker compose -f docker-compose.dev.yml exec dev curl -sS --max-time 5 https://malicious-site.com"
