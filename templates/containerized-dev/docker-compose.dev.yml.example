# Development compose file for containerized AI-agent work (arch-09).
#
# Usage:
#   ./scripts/init-workspace.sh      # writes .env + .env.secret, forwards identity
#   ./scripts/setup-proxy.sh         # generates proxy/allowlist.generated.txt
#   docker compose -f docker-compose.dev.yml up -d --build
#   docker compose -f docker-compose.dev.yml exec dev bash
#
# The image is disposable; only the mounted workspace and named caches persist.
#
# WHAT THIS FILE ENFORCES — and what it does not (read before trusting it):
#   * Deny-by-default egress (arch-09 §4). `devnet` is `internal: true`, so the
#     dev container has NO route to the internet. Its only way out is the
#     `egress` sidecar (tinyproxy), which sits on both networks and refuses
#     every destination that is not in proxy/allowlist.generated.txt. The
#     *_PROXY variables tell tools where the proxy is; a process that ignores
#     or unsets them does not "go direct" — it gets no connection at all.
#     Verify it anyway: the README's deny-path check is the only evidence.
#   * The allow-list is matched by destination HOST. TLS is not inspected, so
#     an allowed host is allowed for every path on it.
#   * It does NOT filter traffic during `docker compose build`: image builds
#     run on the Docker host network, outside devnet. Only running containers
#     are contained. Keep build steps to pinned, reviewed sources (§3).
#   * It does NOT mount the host Docker socket. See the opt-in block below.
#   * Files the host executes, builds from or interpolates (scripts/, proxy/,
#     .devcontainer/, the Dockerfiles, this file, .env, .env.secret, .git/config,
#     .git/hooks, .git/modules, .gitmodules) are mounted READ-ONLY into dev, so
#     an agent inside cannot plant host code, redirect a bind mount or widen the
#     proxy for the next start. Whitelists, git config and submodules are
#     therefore edited on the host, by a human. See the dev volumes block.

services:
  # --- Egress proxy sidecar — the enforcing layer (arch-09 §4) ---------------
  # The ONLY member of devnet that also has internet access. Fails closed: it
  # refuses to start without a readable, non-empty allow-list, and `dev` waits
  # for it to be healthy, so a broken allow-list stops the environment instead
  # of silently opening it.
  egress:
    build:
      context: .
      dockerfile: Dockerfile.egress
    volumes:
      # GENERATED allow-list from scripts/setup-proxy.sh, read once at start-up.
      # After regenerating: docker compose -f docker-compose.dev.yml restart egress
      # Long syntax on purpose: with the short form Docker would CREATE a
      # directory at this path when the file is missing (i.e. compose was run
      # before setup-proxy.sh), and setup-proxy.sh could then never write the
      # file. create_host_path: false makes `compose up` fail instead.
      # The proxy config is NOT mounted — it is baked into the image and
      # asserted by the entrypoint, so an edited copy cannot run an open proxy.
      - type: bind
        source: ./proxy/allowlist.generated.txt
        target: /etc/tinyproxy/filter
        read_only: true
        bind:
          create_host_path: false
    # NO `ports:` here, ever. Publishing 3128 would make this an open proxy for
    # anything that can reach your host; only devnet members may use it.
    networks:
      - devnet
      - egressnet

  dev:
    build:
      context: .
      dockerfile: Dockerfile.dev
      args:
        # Match host UID/GID so bind-mounted files are not root-owned (arch-09 §2).
        USER_UID: ${HOST_UID:-1000}
        USER_GID: ${HOST_GID:-1000}
    working_dir: /workspace
    # Nothing starts until the proxy is up and has loaded a valid allow-list.
    depends_on:
      egress:
        condition: service_healthy
    # Runtime secrets injected from a git-ignored file (arch-09 §5).
    # init-workspace.sh generates .env.secret; never commit it.
    env_file:
      - .env.secret
    environment:
      # Egress proxy pointer (arch-09 §4). setup-proxy.sh writes EGRESS_PROXY,
      # EGRESS_PROXY_HOST/PORT and NO_PROXY into .env. Both cases are set because
      # tools disagree on which they honour (curl/wget/pip/git read lowercase;
      # many Go/Java tools, including gh, read uppercase).
      HTTP_PROXY: ${EGRESS_PROXY:-http://egress:3128}
      HTTPS_PROXY: ${EGRESS_PROXY:-http://egress:3128}
      http_proxy: ${EGRESS_PROXY:-http://egress:3128}
      https_proxy: ${EGRESS_PROXY:-http://egress:3128}
      # NO_PROXY is a *bypass* list, not an allow-list: hosts tools talk to
      # directly on devnet instead of via the proxy — loopback and in-compose
      # service names (e.g. "db,redis"). Listing a public host here does not
      # bypass containment (devnet has no route to it); it just breaks that host.
      NO_PROXY: ${NO_PROXY:-localhost,127.0.0.1,::1}
      no_proxy: ${NO_PROXY:-localhost,127.0.0.1,::1}
      # SSH has no proxy variables. Tunnel git-over-SSH through the proxy with a
      # CONNECT ProxyCommand (netcat-openbsd in Dockerfile.dev; ConnectPort 22 in
      # proxy/tinyproxy.conf). The git host still has to be on the allow-list.
      GIT_SSH_COMMAND: >-
        ssh -o ProxyCommand='nc -X connect -x ${EGRESS_PROXY_HOST:-egress}:${EGRESS_PROXY_PORT:-3128} %h %p'
      # SSH agent forwarding for git push (arch-09 §5).
      SSH_AUTH_SOCK: /ssh-agent
    volumes:
      # The codebase — the single source of truth both humans and agents edit.
      - .:/workspace:cached
      # CONTAINER WRITES, HOST EXECUTES. Everything the host executes, builds
      # from, or interpolates is read-only inside the sandbox; if the agent could
      # edit any of it, it would gain host code execution (or an open proxy) on
      # the next start — defeating the kit. Complete list of host-consumed paths:
      #   scripts/              run on the host by devcontainer.json initializeCommand
      #   .devcontainer/        read by VS Code on the host
      #   docker-compose.dev.yml, Dockerfile.dev, Dockerfile.egress
      #                         read by `compose up --build` on the host
      #   .env                  interpolated by compose: SSH_AUTH_SOCK becomes a
      #                         bind-mount SOURCE below (pointing it at the Docker
      #                         socket would mount it), HOST_UID/GID are build args
      #   .env.secret           env_file — written by init-workspace.sh on the host
      #   proxy/                enforced by the egress sidecar
      #   .git/config, .git/hooks, .git/modules, .gitmodules
      #                         read by EVERY git command you run on the host:
      #                         core.hooksPath/fsmonitor/sshCommand, aliases,
      #                         includes, filters, submodule URLs. No kit script
      #                         runs git on the host, but you do.
      # Nested read-only binds override the writable workspace mount for just
      # these paths; a container without CAP_SYS_ADMIN cannot remount them, sudo
      # or not. Edit infrastructure, git config and submodules on the host. The
      # agent can still commit, branch, fetch and push with the existing config.
      # Long syntax + create_host_path: false so a missing path fails `up`
      # instead of silently becoming an empty directory.
      - ./scripts:/workspace/scripts:ro
      - ./proxy:/workspace/proxy:ro
      - ./.devcontainer:/workspace/.devcontainer:ro
      - ./docker-compose.dev.yml:/workspace/docker-compose.dev.yml:ro
      - ./Dockerfile.dev:/workspace/Dockerfile.dev:ro
      - ./Dockerfile.egress:/workspace/Dockerfile.egress:ro
      - { type: bind, source: ./.env, target: /workspace/.env, read_only: true, bind: { create_host_path: false } }
      - { type: bind, source: ./.env.secret, target: /workspace/.env.secret, read_only: true, bind: { create_host_path: false } }
      - { type: bind, source: ./.git/config, target: /workspace/.git/config, read_only: true, bind: { create_host_path: false } }
      - { type: bind, source: ./.git/hooks, target: /workspace/.git/hooks, read_only: true, bind: { create_host_path: false } }
      # Remove the next two lines if the standards are not vendored as a submodule.
      - { type: bind, source: ./.git/modules, target: /workspace/.git/modules, read_only: true, bind: { create_host_path: false } }
      - { type: bind, source: ./.gitmodules, target: /workspace/.gitmodules, read_only: true, bind: { create_host_path: false } }
      # Git identity, read-only (arch-09 §5).
      - ${HOME}/.gitconfig:/home/developer/.gitconfig:ro
      # SSH agent forwarding for git push (arch-09 §5). On macOS/Linux the host
      # socket path comes from init-workspace.sh via SSH_AUTH_SOCK.
      - ${SSH_AUTH_SOCK:-/dev/null}:/ssh-agent
      # Named caches survive image rebuilds (arch-09 §3).
      - node-modules-cache:/workspace/node_modules
      - dev-cache:/home/developer/.cache
      #
      # OPT-IN — host Docker socket. OFF by default and NOT recommended.
      # Mounting /var/run/docker.sock hands the container root-equivalent control
      # of the host Docker daemon: anything running inside (including an agent
      # with --dangerously-skip-permissions) can start a privileged container,
      # mount the host filesystem and escape the sandbox — and, since the daemon
      # is outside devnet, reach the internet without the proxy. This defeats
      # the "cannot contaminate the host" guarantee in arch-09 and should be
      # enabled only when you have explicitly accepted that trade-off (for
      # example, a project whose task IS building images). Prefer a rootless
      # Docker-in-Docker sidecar or a remote builder if you need `docker` inside.
      # - /var/run/docker.sock:/var/run/docker.sock
    # Keep the container alive so agents/IDEs can exec into it.
    command: sleep infinity
    #
    # OPT-IN — SSH for Zed headless remote (scripts/bootstrap-zed.sh). Requires
    # the openssh-server block in Dockerfile.dev to be enabled as well. Bind to
    # loopback only so the sandbox is not exposed on your LAN.
    # ports:
    #   - "127.0.0.1:2222:22"
    networks:
      - devnet

networks:
  # Internal: members can talk to each other but have NO route outside the
  # network — not to the internet, not to the host LAN. This, not the *_PROXY
  # variables, is what makes egress deny-by-default. Add other project services
  # (database, cache) here and list them in NO_PROXY so tools reach them directly.
  #
  # DNS: on an internal network Docker's embedded resolver must NOT forward
  # external lookups, or DNS labels become an exfiltration channel that no curl
  # check sees. Engines before Moby 26.0.0 / 25.0.5 (CVE-2024-29018) forwarded
  # them when the host used a loopback resolver (systemd-resolved). Require a
  # patched engine (`docker version`) and run the README's DNS deny check.
  devnet:
    driver: bridge
    internal: true
  # The only network with internet access. Only the egress sidecar is on it.
  egressnet:
    driver: bridge

volumes:
  node-modules-cache:
  dev-cache:
