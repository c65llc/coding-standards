# .standards.yml — Project standards configuration
# Generated by coding-standards setup.sh
# Docs: https://coding-standards.c65llc.com/guides/customization/

# Schema version (required)
version: 1

# Languages detected in this project
# Auto-detected during setup; edit to add/remove
languages:
  - python
  - typescript

# AI agents to configure
# Available: claude-code, cursor, copilot, gemini, codex, aider
agents:
  - claude-code
  - cursor
  - copilot

# Project role — determines which role block is included
# Options: service, library, app, data-pipeline
role: service

# Coverage thresholds
coverage:
  minimum: 95    # Overall minimum (%)
  domain: 100    # Domain layer minimum (%)
  # Scoped floors (proc-05 § 6) — optional. Each scope is measured and gated on
  # its own; paths no scope claims fall back to `minimum`.
  #   layer:   domain | core | application | infrastructure | inherited | native | generated
  #   minimum: integer 0-100. domain/core scopes MUST be 100.
  #   reason:  REQUIRED when minimum is below coverage.minimum — say why the code
  #            cannot be measured and where it is verified instead.
  # scopes:
  #   - path: src/domain
  #     layer: domain
  #     minimum: 100
  #   - path: src/app
  #     layer: application
  #     minimum: 95
  #   - path: vendor/engine
  #     layer: inherited
  #     minimum: 0
  #     reason: Upstream engine vendored verbatim; covered by upstream's suite (#210)

# Architecture enforcement
# Options: clean (Clean Architecture enforced), none (no architecture constraints)
architecture: clean

# Security strictness
# strict: P0 and P1 block merge
# moderate: P0 blocks merge, P1 warns
# permissive: all security issues are warnings
security: strict

# Test governance (proc-05)
tests:
  # Flaky-test quarantine registry. Validated by lint-standards (quarantine-policy):
  # six required fields, exact test ids, <= 30-day windows, expired entries fail CI.
  # See templates/test-quarantine.json.example. Default lookup: test-quarantine.json
  # at the project root. Declare a path to move it; a declared file that is
  # missing fails closed.
  # quarantine_file: .github/ci/test-quarantine.json
  # Fast-tier per-test ceiling in milliseconds; also the slow-test top-N report cutoff.
  slow_threshold_ms: 2000
