---
// One footer for every page. The C65 logo paths come from the c65llc.com footer.
const links = [
  { label: 'docs', href: '/getting-started/quick-start/' },
  { label: 'blog', href: '/blog/' },
  { label: 'github', href: 'https://github.com/c65llc/coding-standards' },
  { label: 'rss', href: '/rss.xml' },
  { label: 'c65llc.com', href: 'https://www.c65llc.com/' },
];
---

<footer class="site-footer not-content">
  <div class="inner">
    <div>
      <a class="logo" href="https://www.c65llc.com/">
        <svg role="img" aria-label="C65" viewBox="89.8 156 280.4 148.4" width="76" height="40">
          <path fill="var(--cs-footer-heading)" d="M216 156H164A74.2 74.2 0 0 0 164 304.4H192.5A64.4 64.4 0 0 1 172 278.8H164A48.6 48.6 0 0 1 164 181.6H199.5Z"></path>
          <path fill="var(--cs-ember)" d="M231.6 157.2H262.5L208.5 238.3A25.8 25.8 0 1 0 233 226.9L247.7 203.7A51.6 51.6 0 1 1 187.2 224ZM278.4 158.4H369.2V183.7H261.2ZM283.2 215.3A51.5 51.5 0 1 1 283.2 289.5A64.8 64.8 0 0 0 293.9 266A28.4 28.4 0 1 0 293.9 239A64.8 64.8 0 0 0 283.2 215.3Z"></path>
        </svg>
      </a>
      <p>a C65 project</p>
    </div>
    <nav aria-label="Footer">
      <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <p class="copyright">&copy; {new Date().getFullYear()} C65 LLC</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--cs-footer); color: var(--cs-footer-text); border-top: 1px solid var(--cs-rule); font-family: var(--cs-mono); font-size: 0.82rem; line-height: 1.8; }
  .inner { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1.5rem 3rem; max-width: 1120px; margin: 0 auto; padding: 2rem 1.5rem; }
  p { margin: 0; }
  .logo { display: inline-block; margin-bottom: 0.4rem; border-radius: 4px; }
  ul { display: grid; grid-template-columns: repeat(2, auto); gap: 0.1rem 2.5rem; margin: 0; padding: 0; list-style: none; }
  nav a { color: var(--cs-footer-text); text-decoration: none; }
  nav a:hover { color: var(--cs-footer-heading); text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--cs-ember); outline-offset: 3px; }
</style>
