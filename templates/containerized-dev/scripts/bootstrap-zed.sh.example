#!/usr/bin/env bash
# bootstrap-zed.sh — headless Zed remote against the dev container (arch-09 §7).
#
# Zed's remote development connects over SSH, so this path needs two opt-ins the
# starter kit leaves OFF by default:
#   1. Dockerfile.dev: enable the "openssh-server" block (installs and starts sshd).
#   2. docker-compose.dev.yml: enable the `ports:` block ("127.0.0.1:2222:22").
# The script checks both before touching anything and exits with instructions
# if either is missing, so it never writes an SSH Host entry that cannot work.
#
# Non-destructive: appends an SSH Host block only if absent, then installs the
# Zed remote server inside the running container.
set -euo pipefail

HOST_ALIAS="${ZED_HOST_ALIAS:-dev-container}"
SSH_CONFIG="${HOME}/.ssh/config"
COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.dev.yml}"
SERVICE="${DEV_SERVICE:-dev}"

warn() { printf '\033[1;33m%s\033[0m\n' "$1" >&2; }
green() { printf '\033[0;32m%s\033[0m\n' "$1"; }
die()  { warn "$1"; exit 1; }

command -v docker >/dev/null 2>&1 || die "docker not found on host; cannot bootstrap Zed remote."

# --- Preflight 1: is sshd present in the running container? -------------------
if ! docker compose -f "$COMPOSE_FILE" exec -T "$SERVICE" sh -c 'command -v sshd >/dev/null' 2>/dev/null; then
    warn "sshd is not installed in the '${SERVICE}' container."
    warn "Enable the openssh-server opt-in block in Dockerfile.dev, rebuild, then re-run."
    die  "Zed remote needs an SSH server in the container; nothing was changed."
fi

# --- Preflight 2: is container port 22 published on the host? -----------------
# `docker compose port` prints host:port for a published container port, or
# nothing when the service does not publish it.
published="$(docker compose -f "$COMPOSE_FILE" port "$SERVICE" 22 2>/dev/null || true)"
if [ -z "$published" ]; then
    warn "Service '${SERVICE}' does not publish container port 22."
    warn "Enable the ports opt-in block in ${COMPOSE_FILE} (e.g. \"127.0.0.1:2222:22\"), recreate, then re-run."
    die  "Zed remote needs a reachable SSH port; nothing was changed."
fi
HOST_ADDR="${published%:*}"
HOST_PORT="${published##*:}"
[ "$HOST_ADDR" = "0.0.0.0" ] && HOST_ADDR="127.0.0.1"

# --- SSH Host block (append-only, skip if present) -----------------------------
mkdir -p "$(dirname "$SSH_CONFIG")"
touch "$SSH_CONFIG"

if grep -qE "^Host[[:space:]]+${HOST_ALIAS}\$" "$SSH_CONFIG"; then
    warn "SSH Host '${HOST_ALIAS}' already present in ${SSH_CONFIG} — leaving it untouched."
else
    {
        echo ""
        echo "# Added by bootstrap-zed.sh (arch-09 §7)"
        echo "Host ${HOST_ALIAS}"
        echo "    HostName ${HOST_ADDR}"
        echo "    Port ${HOST_PORT}"
        echo "    User developer"
        echo "    StrictHostKeyChecking accept-new"
    } >> "$SSH_CONFIG"
    green "Added SSH Host ${HOST_ALIAS} -> ${HOST_ADDR}:${HOST_PORT}"
fi

# --- Zed remote server inside the container (idempotent on Zed's side) --------
docker compose -f "$COMPOSE_FILE" exec -T "$SERVICE" \
    bash -lc 'curl -fsSL https://zed.dev/install.sh | sh' \
    && green "Zed remote server installed in the container."

echo "Connect from Zed: 'zed ssh://${HOST_ALIAS}/workspace'"
