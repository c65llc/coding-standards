# .standards.yml — Project standards configuration
# Generated by coding-standards setup.sh
# Docs: https://coding-standards.c65llc.com/guides/customization/

# Schema version (required)
version: 1

# Languages detected in this project
# Auto-detected during setup; edit to add/remove
languages:
  - python
  - typescript

# AI agents to configure
# Available: claude-code, cursor, copilot, gemini, codex, aider
agents:
  - claude-code
  - cursor
  - copilot

# Project role — determines which role block is included
# Options: service, library, app, data-pipeline
role: service

# Monorepo members — sub-roots that are projects in their own right, each with
# its own .standards.yml (languages, lint.exclude, coverage ...). Paths are
# relative to this file; absolute paths, "..", and symlinks (or paths that
# resolve outside the project) are rejected and reported.
#   - lint-standards.sh runs repo-wide checks (secrets, commits, CI hygiene,
#     docs) once at the root and project/language checks in every member,
#     aggregating one report (JSON/SARIF results carry a "member" field).
#   - doctor.sh checks each member's languages against its own config.
#   - setup.sh / sync-standards.sh assemble the root agent configs from the
#     union of the root's and the members' languages, and setup bootstraps a
#     .standards.yml for a declared member that has none.
# Omit the key to auto-discover every */.standards.yml and */*/.standards.yml
# (hidden dirs, node_modules, vendor, dist, build, target are skipped); set
# `members: []` to disable discovery for a single-root project.
# members:
#   - server
#   - web
#   - shells/apple

# Coverage thresholds
coverage:
  minimum: 95    # Overall minimum (%)
  domain: 100    # Domain layer minimum (%)
  # Scoped floors (proc-05 § 6) — optional. Each scope is measured and gated on
  # its own; paths no scope claims fall back to `minimum`.
  #   layer:   domain | core | application | infrastructure | inherited | native | generated
  #   minimum: integer 0-100. domain/core scopes MUST be 100.
  #   reason:  REQUIRED when minimum is below coverage.minimum — say why the code
  #            cannot be measured and where it is verified instead.
  # scopes:
  #   - path: src/domain
  #     layer: domain
  #     minimum: 100
  #   - path: src/app
  #     layer: application
  #     minimum: 95
  #   - path: vendor/engine
  #     layer: inherited
  #     minimum: 0
  #     reason: Upstream engine vendored verbatim; covered by upstream's suite (#210)

# Architecture enforcement
# Options: clean (Clean Architecture enforced), none (no architecture constraints)
architecture: clean

# Security strictness
# strict: P0 and P1 block merge
# moderate: P0 blocks merge, P1 warns
# permissive: all security issues are warnings
security: strict

# Test governance (proc-05)
tests:
  # Flaky-test quarantine registry. Validated by lint-standards (quarantine-policy):
  # six required fields, exact test ids, <= 30-day windows, expired entries fail CI.
  # See templates/test-quarantine.json.example. Default lookup: test-quarantine.json
  # at the project root. Declare a path to move it; a declared file that is
  # missing fails closed.
  # quarantine_file: .github/ci/test-quarantine.json
  # Fast-tier per-test ceiling in milliseconds; also the slow-test top-N report cutoff.
  slow_threshold_ms: 2000

# Conventional Commits enforcement (lint-checks/common/conventional-commits.sh,
# check-commit-message.sh hooks, and the standards-review PR-title check).
# Defaults: the last 50 non-merge commits locally; the PR's own commits in the
# standards-review action. Precedence: since > PR range (CI) > window.
# commits:
#   window: 50             # Inspect the last N non-merge commits (default 50);
#                          # a pinned window is ignored when a range applies
#   since: origin/main     # Inspect <ref>..HEAD instead (wins over window)
#   scopes:                # Optional allow-list: scoped commits must use one of these
#     - api
#     - domain
#     - ui

# Compliance linter options (lint-standards.sh)
# exclude: project-relative paths that the banned-functions checks skip, in
# addition to .gitignore and the built-in exclusions (node_modules, vendor,
# dist, build, target, coverage, .worktrees, .claude/worktrees, ...). Entries
# are path prefixes or shell-style globs (* within a segment, ** across
# segments, **/ may match zero segments). no-secrets ignores this list and
# scans every tracked file, so it cannot be used to hide a committed secret.
# lint:
#   exclude:
#     - docs/
#     - fixtures/**

# Project text assembled into the agent configs: {{PROJECT_OVERVIEW}} and
# {{KEY_COMMANDS}} in the base templates (the "Project Overview" and "Key
# Commands" sections of CLAUDE.md). Persisting them here is what lets a
# re-assembly reproduce a filled-in config byte for byte, so its checksum stays
# stable and sync never stages it as customized. Without them the assembler
# writes <!-- TODO(standards): --> markers; when a config already has these
# sections filled in by hand, setup and sync print the YAML to add here
# (Claude Code: /merge-standards writes it). Literal blocks (`|`) or one-line
# scalars.
# project_overview: |
#   One paragraph: what this project is, what it is made of and how the pieces
#   fit together.
# key_commands: |
#   make test        # run the test suite
#   make lint        # lint and format checks
#   make run         # start the service locally

# Hand-curated agent configs. By default every assembled config is managed:
# sync regenerates it when its checksum matches and stages a pending copy when
# it does not. A file declared `false` here is yours: setup and sync never
# regenerate or stage it, doctor reports it as curated instead of drifted, and
# diff-standards still shows the upstream template changes for manual review
# (they do not fail --exit-code). Keys are the config's path or basename;
# inline `managed: { CLAUDE.md: false }` works too.
# managed:
#   CLAUDE.md: false
#   .github/copilot-instructions.md: false

# Git hook manager that owns the post-merge standards-sync reminder and the
# commit-msg hook. Default `standards`: setup.sh writes the native
# .git/hooks/post-merge. Declare `lefthook` or `husky` to pin the manager
# doctor checks (its config file must exist), or `custom` for your own
# (`make hooks`, a pre-commit framework, ...): setup then leaves the native hook
# alone and doctor's hook check passes without inspecting it.
# hooks: custom

# Agent worktree root (proc-04 § Worktree Hygiene). One gitignored directory per
# repository, project-relative (absolute, ~ and .. paths are rejected and the
# default used). setup.sh adds it to .gitignore and installs a pre-commit guard
# that refuses commits staging paths under it; doctor.sh reports the worktrees
# there (count, idle age, size) and warns on nesting and strays elsewhere;
# worktree-gc.sh collects merged, gone and idle ones. Default: .claude/worktrees.
# worktree_dir: .claude/worktrees
