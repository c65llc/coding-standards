# TruffleHog secret scanning — copy to .github/workflows/trufflehog.yml
#
# Scans pushes and PRs for committed secrets. Unignored findings BLOCK the
# check (P0 per sec-01 §3). Verification is intentionally OFF via
# `--no-verification` (TruffleHog verifies by default; merely omitting
# --only-verified does not turn it off): we do not send detected secrets to
# third-party endpoints. With verification off every detection is
# "unverified", so --results must include it or the scan reports nothing.
# Noisy *paths* are excluded via the committed .trufflehog-ignore file
# (--exclude-paths, path regexes). Suppress an individual false positive with an
# inline `// trufflehog:ignore` comment on the offending line instead.
#
# ci-hygiene: paths-exempt — a secret can land in any file, so the scan runs
# on every PR regardless of which paths changed.
name: Secret Scan

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: trufflehog-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  trufflehog:
    name: TruffleHog
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          # Full history so a PR diff scan has both endpoints to compare.
          fetch-depth: 0

      - name: Run TruffleHog
        uses: trufflesecurity/trufflehog@00155c9dc586f34d189adc83d3ac2698c2ec551f # v3.95.8
        with:
          # Scan the whole checkout. On PRs, TruffleHog auto-scopes to the diff.
          path: ./
          # --no-verification: never call provider APIs with a detected secret;
          # --results must then include `unverified` (all detections are);
          # --exclude-paths respects the committed allowlist.
          extra_args: --no-verification --results=unverified,unknown --exclude-paths=.trufflehog-ignore
