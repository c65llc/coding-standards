# .gitleaks.toml — shape-based allowlist for Gitleaks. Copy to .gitleaks.toml.
#
# Requires Gitleaks >= 8.21 (October 2024). The file uses the `[[allowlists]]`
# array-of-tables form throughout: Gitleaks refuses a config that mixes it with
# the legacy single `[allowlist]` table, and only the plural form can AND a
# path condition with a shape. On an older release, rename the first block to
# `[allowlist]`, delete the `condition = "AND"` blocks, and mark their fixture
# lines inline instead.
#
# sec-01 §3 "Scanner False Positives on Test Fixtures". Test fixtures trip
# secret scanners for predictable reasons: UUIDv7 ids look like tokens, a
# redaction test needs a plausible password to redact, a fake credential in a
# `*_test` file is the whole point of the test. The usual response — a second
# and third allowlist round, each excluding one more PATH — ends with whole
# trees unscanned. Allowlist the SHAPE of the false positive instead, and when
# the shape is one a real secret can also take, require the fixture LOCATION
# as well. Path excludes are the last resort, and every entry states why it
# exists.
#
# Two mechanisms, finest granularity first:
#   1. Inline, on the exact line:   `… // gitleaks:allow`  (Gitleaks)
#                                   `… // trufflehog:ignore` (TruffleHog)
#      Put BOTH markers on a line that trips both scanners. The marker
#      documents the false positive where a reader meets it and keeps the rest
#      of the file scanned. Prefer this for one-off constants.
#   2. This file, for a shape that recurs across many fixtures.
#
# Blocks below, in increasing reach:
#   A. Global shapes — regexes that match ONLY a form no real secret takes.
#   B. Fixture path AND shape — forms a real secret CAN take (a UUID, a token
#      that happens to contain "example"), suppressed only inside test paths.
#      Not a path exclude: a non-matching secret in a test file is reported.
#   C. Path excludes — all-noise paths, last resort.
# No block sets `regexTarget`, so Gitleaks tests the regexes against the
# extracted SECRET (the rule's capture group), which is what anchored shapes
# expect — `password = "test-foo"` is suppressed because `test-foo` matches,
# and a real secret sharing a line with a fixture is still reported.
# Regexes are Go RE2: no backreferences, no lookaround.

title = "project gitleaks config"

[extend]
# Start from the built-in rule set; this file only adds allowlist entries.
useDefault = true

# ---------------------------------------------------------------------------
# A. Global shapes — forms no real secret takes, anywhere in the repository
# ---------------------------------------------------------------------------
[[allowlists]]
description = "Shapes no real secret takes (sec-01 §3)"
regexes = [
  # Fake passwords by naming convention: a value that announces itself
  # (test-, fake-, dummy-, example-, not-a-real-, changeme) is a fixture, not
  # a credential. Keep the convention and the scanner stays quiet.
  '''^(test|fake|dummy|example|placeholder|not-a-real|changeme|hunter2)[-_a-zA-Z0-9]*$''',
  # Redaction-test output: the scanner sees the redacted form, which is only
  # asterisks or the literal REDACTED marker, never a secret.
  '''^(\*{4,}|\[?REDACTED\]?|<redacted>)$''',
  # Repeated-character fixtures (`xxxxxxxx…`, `0000…`, `aaaa…`) used to pad a
  # token to the right length in a parser test. RE2 has no backreference, so
  # the usual padding characters are enumerated; add yours to the alternation.
  '''(?i)^(0{16,}|1{16,}|9{16,}|a{16,}|f{16,}|x{16,}|z{16,})$''',
]

# ---------------------------------------------------------------------------
# B. Fixture path AND shape — both conditions must hold (`condition = "AND"`
#    spans every condition a block declares, so the UUID shapes and the
#    stopwords sit in separate blocks: a UUID need not also contain a word).
# ---------------------------------------------------------------------------
[[allowlists]]
description = "UUID-shaped ids in test fixtures only (sec-01 §3)"
# A UUID is a shape many services issue API keys in, so the shape alone does
# not make a value safe; it is accepted only inside a test or fixture path.
condition = "AND"
paths = [
  '''(^|/)(tests?|__tests__|spec|fixtures)/''',
  '''(_test|\.test|\.spec|_spec)\.[A-Za-z0-9]+$''',
]
regexes = [
  # UUIDv7 (version nibble 7, variant 8-b): time-ordered fixture primary keys.
  '''^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$''',
  # Any RFC 4122 UUID (v1–v5) for fixtures that are not time-ordered.
  '''^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$''',
]

[[allowlists]]
description = "Fixture stopwords in test paths only (sec-01 §3)"
# Stopwords are a case-insensitive SUBSTRING match on the secret, so a real
# credential such as `prod-example-customer-key` would also contain one.
# Confined to test paths, a token that contains one is a fixture by
# construction; elsewhere it is still reported.
condition = "AND"
paths = [
  '''(^|/)(tests?|__tests__|spec|fixtures)/''',
  '''(_test|\.test|\.spec|_spec)\.[A-Za-z0-9]+$''',
]
stopwords = [
  "example",
  "fixture",
  "placeholder",
  "not-a-real",
  "redacted",
]

# ---------------------------------------------------------------------------
# C. Path excludes — the LAST resort. Each one covers a path that is all-noise
#    by construction (lockfile hashes, generated bundles). Never exclude
#    `tests/` or `fixtures/` wholesale: block B covers the fixture shapes, and a
#    real secret pasted into a test file must still be caught.
# ---------------------------------------------------------------------------
[[allowlists]]
description = "All-noise paths (sec-01 §3, last resort)"
paths = [
  '''(^|/)pnpm-lock\.yaml$''',
  '''(^|/)package-lock\.json$''',
  '''(^|/)yarn\.lock$''',
  '''(^|/)Cargo\.lock$''',
  '''(^|/)poetry\.lock$''',
  '''(^|/)Package\.resolved$''',
  '''\.min\.(js|css)$''',
  '''(^|/)dist/''',
]
