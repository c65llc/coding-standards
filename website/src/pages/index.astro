---
import '@fontsource-variable/figtree';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/home.css';
import SiteFooter from '../components/SiteFooter.astro';
import Wordmark from '../components/Wordmark.astro';
// Read from the real block so the sample on the page cannot drift from what ships.
import architectureCore from '../../../standards/shared/blocks/architecture-core.md?raw';

const title = 'Coding Standards — One Standards Framework. Every AI Agent.';
const description = 'Unified coding standards for every AI coding assistant. Keep Cursor, Copilot, Claude Code, Codex, and Gemini CLI all writing consistent, clean code.';
const githubUrl = 'https://github.com/c65llc/coding-standards';
const docsUrl = '/getting-started/quick-start/';
const installCmd = 'curl -fsSL https://raw.githubusercontent.com/c65llc/coding-standards/main/install.sh | bash';

const rulePath = 'standards/shared/blocks/architecture-core.md';
const ruleLines = architectureCore.split('\n');
const ruleStart = ruleLines.findIndex((line) => line.startsWith('Validate inputs at boundaries.'));
if (ruleStart === -1) throw new Error(`${rulePath}: the line quoted on the homepage is gone`);
const sample = ruleLines.slice(ruleStart, ruleStart + 3).map((text, i) => ({ number: ruleStart + i + 1, text }));

const outputs = [
  { file: 'CLAUDE.md', agent: 'Claude Code' },
  { file: 'AGENTS.md', agent: 'Codex' },
  { file: '.cursorrules', agent: 'Cursor' },
  { file: '.github/copilot-instructions.md', agent: 'Copilot' },
  { file: '.gemini/GEMINI.md', agent: 'Gemini CLI' },
  { file: '.aider-instructions.md', agent: 'Aider' },
];

const before = [
  'Each tool configured separately, and the configs contradict each other',
  'Standards live in a wiki page nobody reads, and drift',
  'Code review spent on style instead of logic bugs',
];
const after = [
  'One source of truth, compiled for every agent',
  'The same architecture and naming in every repository',
  'Review time goes to what the code does',
];

const points = [
  { tag: 'sync', title: 'Multi-agent sync', desc: 'No more conflicting styles across tools.' },
  { tag: 'architecture', title: 'Clean architecture', desc: 'The same principles across 14 languages.' },
  { tag: 'setup', title: 'One command', desc: 'Rules land where each agent expects them.' },
  { tag: 'updates', title: 'Stays current', desc: 'Git hooks re-sync. Customized agent configs are never overwritten.' },
];

const steps = [
  { title: 'Install', desc: 'Run a single install command in your repo.' },
  { title: 'Standards sync to all agents', desc: 'Config files are generated for Cursor, Copilot, Claude Code, Codex, Gemini CLI, and Aider.' },
  { title: 'Consistent code', desc: 'Every AI assistant follows the same architecture and style rules.' },
];

const languages = ['Python', 'Java', 'Kotlin', 'Swift', 'Dart', 'TypeScript', 'JavaScript', 'Rust', 'Zig', 'Ruby',
  'Ruby on Rails', 'Go', 'Elixir', 'C++'];

// Apps built with these standards: each one's repository includes them as the
// `.standards` submodule. Keep in step with "Usage" in README.md.
const usage = [
  { name: 'Sosta Logbook', desc: 'Journal', site: 'https://sostalog.com' },
  { name: 'Dopo Tasks', desc: 'Tasks', site: 'https://dopotasks.com' },
  { name: 'Pigeonpile Wiki', desc: 'Wiki', site: 'https://pigeonpile.com/apps/wiki' },
  { name: 'Sprig Edit', desc: 'Markdown editor', site: 'https://sprigedit.com' },
  { name: 'Away Team', desc: 'Trip planning', site: 'https://awayteamapp.com' },
];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://coding-standards.c65llc.com/og-image.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Coding Standards Blog" href="/rss.xml" />
  </head>

  <body>
    <header class="nav wrap">
      <Wordmark />
      <nav aria-label="Main">
        <a href={docsUrl}>docs</a>
        <a href="/blog/">blog</a>
        <a href="#usage">usage</a>
        <a href={githubUrl}>github</a>
        <a href="/rss.xml">rss</a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <h1>Write the rule once.</h1>
        <p class="lead">One set of coding standards, compiled into the file each AI agent already reads.</p>
        <div class="command">
          <code><span class="prompt" aria-hidden="true">$ </span>{installCmd}</code>
          <button type="button" class="copy" data-copy={installCmd} aria-live="polite" hidden>copy</button>
        </div>
        <p class="actions">
          <a class="button" href={docsUrl}>Get started</a>
          <a class="more" href={githubUrl}>View on GitHub</a>
        </p>
      </section>

      <section class="compile wrap" id="compile" aria-label="A rule and the files it lands in">
        <figure class="window">
          <figcaption><span>{rulePath}</span><span>source</span></figcaption>
          <ol class="source">
            {sample.map((line) => (
              <li><span class="number">{line.number}</span> <span>{line.text}</span></li>
            ))}
          </ol>
        </figure>
        <figure class="window">
          <figcaption><span>your-repo/</span><span>generated</span></figcaption>
          <ul class="tree">
            {outputs.map((o) => (
              <li><code>{o.file}</code> <span class="agent">{o.agent}</span></li>
            ))}
          </ul>
        </figure>
      </section>

      <section class="band" id="why">
        <div class="wrap">
          <h2>Why coding standards?</h2>
          <p class="intro">Every agent has its own habits. Without shared rules your codebase becomes a patchwork that is harder to review and maintain.</p>
          <figure class="window diff">
            <figcaption><span>your-team.diff</span><span>before / after</span></figcaption>
            <div class="lines">
              {before.map((line) => <div class="del">- {line}</div>)}
              {after.map((line) => <div class="add">+ {line}</div>)}
            </div>
          </figure>
          <ul class="points">
            {points.map((p) => (
              <li>
                <span class="tag">// {p.tag}</span>
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
              </li>
            ))}
          </ul>
          <p><a class="more" href="/why/">compare the approaches &rarr;</a></p>
        </div>
      </section>

      <section class="band" id="how">
        <div class="wrap">
          <h2>How it works</h2>
          <ol class="rows steps">
            {steps.map((s) => (
              <li><h3>{s.title}</h3><p>{s.desc}</p></li>
            ))}
          </ol>
        </div>
      </section>

      <section class="band" id="languages">
        <div class="wrap">
          <h2>{languages.length} languages</h2>
          <p class="intro">Consistent architecture and idioms across every language your team uses.</p>
          <ul class="chips">{languages.map((l) => <li>{l}</li>)}</ul>
        </div>
      </section>

      <section class="band" id="usage">
        <div class="wrap">
          <h2>Built with it</h2>
          <p class="intro"><a href="https://www.c65llc.com">C65</a> builds its own apps with these standards, three of them in the <a href="https://pigeonpile.com">Pigeonpile</a> suite.</p>
          <ul class="rows apps">
            {usage.map((u) => (
              <li>
                <span class="name">{u.name}</span>
                <span>{u.desc}</span>
                <a href={u.site}>{new URL(u.site).host}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="band closing">
        <div class="wrap">
          <h2>Get started in 5 minutes</h2>
          <div class="command">
            <code><span class="prompt" aria-hidden="true">$ </span>{installCmd}</code>
            <button type="button" class="copy" data-copy={installCmd} aria-live="polite" hidden>copy</button>
          </div>
          <p class="actions"><a class="button" href={docsUrl}>Read the docs</a></p>
        </div>
      </section>
    </main>

    <SiteFooter />

    <script>
      // The buttons ship hidden: without JavaScript or a clipboard there is nothing to offer.
      if (navigator.clipboard) {
        document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
          button.hidden = false;
          button.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(button.dataset.copy ?? '');
              button.textContent = 'copied';
            } catch {
              button.textContent = 'select and copy';
            }
            setTimeout(() => (button.textContent = 'copy'), 2000);
          });
        });
      }
    </script>
  </body>
</html>
